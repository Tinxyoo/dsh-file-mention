{
  "name": "dsh-file-mention",
  "version": "1.0.0",
  "description": "为 DeepSeek Harness 右侧目录树面板文件，以及文件里选中的内容，提供可一键引用到输入框的功能。",
  "type": "module",
  "license": "MIT",
  "author": "Tinxyoo <Dremo@qq.com>",
  "homepage": "https://tinxyoo.github.io/dsh-file-mention/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tinxyoo/dsh-file-mention.git"
  },
  "bugs": {
    "url": "https://github.com/Tinxyoo/dsh-file-mention/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "file",
    "mention",
    "reference",
    "quote",
    "composer",
    "ui"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-sidebar-files"
      ]
    }
  }
}
